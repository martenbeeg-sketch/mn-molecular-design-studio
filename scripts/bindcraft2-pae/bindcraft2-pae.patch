+def write_pae_matrix(structure_path: str, prediction: StructurePrediction, receptor_chains: dict[str, tuple[tuple[str, int, int], ...]] | None=None) -> str | None:
+    """Write the prediction PAE in the residue order of its matching output CIF."""
+    protein_complex = prediction.protein_complex
+    pae = prediction.metrics.get('pae_raw', prediction.metrics.get('pae'))
+    if pae is None:
+        print(f'warning: no PAE matrix available for {structure_path}', flush=True)
+        return None
+    source_chains = sorted(protein_complex)
+    offsets, next_offset = {}, 0
+    for name in source_chains:
+        offsets[name] = next_offset
+        next_offset += len(protein_complex[name])
+    chains = written_chains(protein_complex, receptor_chains)
+    residue_indices, chain_map = [], []
+    output_offset = 0
+    for chain in chains:
+        count = chain.stop - chain.start
+        source_offset = offsets[chain.complex_chain] + chain.start
+        residue_indices.extend(range(source_offset, source_offset + count))
+        chain_map.append({
+            'cif_chain': chain.letter,
+            'source_chain': chain.complex_chain,
+            'label': chain.label or None,
+            'source_residue_start': chain.start,
+            'source_residue_stop': chain.stop,
+            'matrix_residue_start': output_offset,
+            'matrix_residue_stop': output_offset + count,
+        })
+        output_offset += count
+    pae = np.asarray(pae, dtype=float)
+    if pae.shape != (next_offset, next_offset) or len(residue_indices) != next_offset:
+        print(f'warning: PAE shape {pae.shape} does not match {next_offset} structure residues for {structure_path}; skipped PAE sidecar', flush=True)
+        return None
+    pae = pae[np.ix_(residue_indices, residue_indices)]
+    payload = {
+        'format': 'bindcraft2_pae_v1',
+        'pae': pae.tolist(),
+        'chain_order': chain_map,
+    }
+    plddt = prediction.metrics.get('plddt')
+    if plddt is not None:
+        plddt = np.asarray(plddt, dtype=float).reshape(-1)
+        if plddt.size == next_offset:
+            payload['plddt'] = (plddt[residue_indices] * 100.0).tolist()
+    pae_path = os.path.splitext(structure_path)[0] + '.pae.json'
+    with open(pae_path, 'w', encoding='utf-8') as handle:
+        json.dump(payload, handle, separators=(',', ':'))
+        handle.write('\n')
+    return pae_path
+
