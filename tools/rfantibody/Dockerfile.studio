# Molecular Design Studio image for the upstream RFantibody pipeline.
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PROJECT_ENVIRONMENT=/opt/rfantibody/.venv \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    RFANTIBODY_ROOT=/opt/rfantibody \
    RFANTIBODY_WEIGHTS=/opt/rfantibody/weights

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git libgl1 libglib2.0-0 libgomp1 \
    python3.10 python3.10-dev python3.10-venv && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /uvx /usr/local/bin/
WORKDIR /opt/rfantibody
COPY . /opt/rfantibody

RUN uv sync --frozen --no-dev && \
    mkdir -p /opt/rfantibody/weights && \
    curl --fail --location --retry 3 --retry-delay 2 \
      https://files.ipd.uw.edu/pub/RFantibody/RFdiffusion_Ab.pt \
      --output /opt/rfantibody/weights/RFdiffusion_Ab.pt && \
    curl --fail --location --retry 3 --retry-delay 2 \
      https://files.ipd.uw.edu/pub/RFantibody/ProteinMPNN_v48_noise_0.2.pt \
      --output /opt/rfantibody/weights/ProteinMPNN_v48_noise_0.2.pt && \
    curl --fail --location --retry 3 --retry-delay 2 \
      https://files.ipd.uw.edu/pub/RFantibody/RF2_ab.pt \
      --output /opt/rfantibody/weights/RF2_ab.pt && \
    test "$(stat -c %s /opt/rfantibody/weights/RFdiffusion_Ab.pt)" -gt 400000000 && \
    test "$(stat -c %s /opt/rfantibody/weights/ProteinMPNN_v48_noise_0.2.pt)" -gt 5000000 && \
    test "$(stat -c %s /opt/rfantibody/weights/RF2_ab.pt)" -gt 250000000 && \
    chmod -R a+rX /opt/rfantibody && \
    chmod a+w /opt/rfantibody

ENV PATH="/opt/rfantibody/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
CMD ["bash"]
